# ===================================
# КОНФИГУРАЦИЯ ПРИЛОЖЕНИЯ
# ===================================
# Скопируйте этот файл в .env и заполните своими ключами
# cp .env.example .env (Linux/Mac)
# copy .env.example .env (Windows)

# ===================================
# ОСНОВНЫЕ НАСТРОЙКИ
# ===================================

# Модель для использования (выберите одну):
# - openai: Использует GPT-4o-mini через OpenAI API (РЕКОМЕНДУЕТСЯ для Windows)
# - local: Использует локальную Llama 3 (требует мощный ПК с 16GB+ RAM)
MODEL_TYPE=openai

# ===================================
# API КЛЮЧИ
# ===================================

# OpenAI API Key (ОБЯЗАТЕЛЬНО для MODEL_TYPE=openai)
# Получить: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Unstructured API Key (ОПЦИОНАЛЬНО - платная обработка документов)
# Получить бесплатный ключ: https://unstructured.io/api-key-hosted
# ⚠️ МОЖНО НЕ УКАЗЫВАТЬ - используется БЕСПЛАТНАЯ локальная обработка!
UNSTRUCTURED_API_KEY=your_unstructured_api_key_here
UNSTRUCTURED_URL=https://api.unstructuredapp.io/general/v0/general

# Режим обработки документов (можно переключать в интерфейсе!)
# - local: Локальная обработка (БЕСПЛАТНО, конфиденциально)
# - api: API обработка (платно, требуется API ключ)
UNSTRUCTURED_MODE=local

# Стратегия локальной обработки (только для UNSTRUCTURED_MODE=local)
# - fast: Быстрая обработка (рекомендуется, ~10-30 сек на документ)
# - hi_res: Высокое качество (медленнее, ~1-3 мин, требует дополнительные пакеты)
UNSTRUCTURED_STRATEGY=fast

# HuggingFace Token (только для MODEL_TYPE=local)
# Получить: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ===================================
# ВЕКТОРНАЯ БАЗА ДАННЫХ
# ===================================

# Тип векторной БД (faiss или chroma)
# - faiss: Быстрая, в памяти, отлично для небольших данных
# - chroma: Персистентная, с дополнительными возможностями
DB_TYPE=faiss

# ===================================
# ПУТИ К ДАННЫМ
# ===================================

DATA_DIR=./Data
OUTPUT_DIR=./output
FAISS_INDEX_PATH=./faiss_index
CHROMA_DB_PATH=./chroma_db
CHROMA_CATALOG_PATH=./chroma_catalog
CATALOG_PATH=./catalog.json

# ===================================
# ИНСТРУКЦИЯ ПО НАСТРОЙКЕ
# ===================================
#
# ДЛЯ БЫСТРОГО СТАРТА (рекомендуется):
# 1. Укажите OPENAI_API_KEY
# 2. MODEL_TYPE=openai
# 3. Unstructured API можно НЕ указывать (обработка будет локальной)
#
# ДЛЯ МАКСИМАЛЬНОГО КАЧЕСТВА:
# 1. Укажите OPENAI_API_KEY
# 2. Укажите UNSTRUCTURED_API_KEY
# 3. MODEL_TYPE=openai
#
# ДЛЯ ПОЛНОСТЬЮ ЛОКАЛЬНОЙ РАБОТЫ:
# 1. Укажите HUGGINGFACE_TOKEN
# 2. MODEL_TYPE=local
# 3. Требуется мощный ПК (16GB+ RAM, желательно GPU с CUDA)

